              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Tạo booking thành công (Status 200)\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Tên khách hàng khớp với dữ liệu đầu vào\", function () {\r\n    var jsonData = pm.response.json();\r\n    var expectedFirstName = pm.iterationData.get(\"firstname\");\r\n    pm.expect(jsonData.booking.firstname).to.eql(expectedFirstName);\r\n});\r\nvar jsonData = pm.response.json();\r\npm.environment.set(\"bookingid\", jsonData.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"firstname\": \"{{firstname}}\",\r\n  \"lastname\": \"{{lastname}}\",\r\n  \"totalprice\": {{totalprice}},\r\n  \"depositpaid\": {{depositpaid}},\r\n  \"bookingdates\": {\r\n    \"checkin\": \"{{checkin}}\",\r\n    \"checkout\": \"{{checkout}}\"\r\n  },\r\n  \"additionalneeds\": \"{{additionalneeds}}\"\r\n}\r\n",
